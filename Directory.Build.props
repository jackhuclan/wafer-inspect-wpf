<Project>

  <!--
    全解决方案共享工程元数据（目录树下所有 .csproj 自动导入）。
    发布 / 升级版本时只改这一处：Version 同时作用于程序集版本与 NuGet 包版本。
    规范沿用 aoi_twin_demo 仓库（CPM / .editorconfig / 中文 Conventional Commits）。
  -->
  <PropertyGroup>

    <!-- 版本：语义化版本，单点维护 -->
    <Version>1.1.0</Version>

    <Authors>jackhuclan</Authors>
    <Company>jackhuclan</Company>

    <Product>WaferInspect</Product>
    <Description>
      晶圆检测上位机：.NET 10 WPF，设备状态、检测任务、EL/PL/AOI 晶圆图谱、
      实时良率趋势与告警闭环；左侧导航支持分组配置与独立折叠。
    </Description>

    <PackageProjectUrl>https://github.com/jackhuclan/wafer-inspect-wpf</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jackhuclan/wafer-inspect-wpf.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <Copyright>Copyright © 2026 jackhuclan</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>true</IncludeSourceRevisionInInformationalVersion>

    <!-- 语言基线 -->
    <!-- 渐进项：ViewModel/Models 仍含大量 XAML 绑定属性与 WPF 类型契约，
         全量启用可空引用会产生 120 条 CS86xx 警告；待 ViewModel 下沉到
         net10.0 独立层时统一切到 enable。当前显式 disable 以保证 0 警告。 -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- 检查清单要求 0 警告 0 错误：警告直接失败，避免风格债务累积 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

  </PropertyGroup>

</Project>
