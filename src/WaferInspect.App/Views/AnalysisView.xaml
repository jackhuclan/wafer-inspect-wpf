<UserControl xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="WaferInspectHMI.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WaferInspectHMI.Views"
             FontFamily="Segoe UI, Microsoft YaHei" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="372"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="392"/>
        </Grid.ColumnDefinitions>

        <!-- 左：Wafer 数据检索（F-3.9.2-01~21） -->
        <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,0">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock Text="Wafer 数据检索" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="3.9.2" Style="{StaticResource PanelSub}" Margin="8,0,0,0"/>
                    </DockPanel>
                </Border>
                <WrapPanel Grid.Row="1" Margin="10,10,10,6">
                    <TextBox Width="86" Margin="0,0,6,0" AutomationProperties.AutomationId="TxtLotFilter"
                             ToolTip="按 LotId 筛选" Text="{Binding LotFilter, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Width="86" Margin="0,0,6,0" AutomationProperties.AutomationId="TxtWaferFilter"
                             ToolTip="按 WaferId 筛选" Text="{Binding WaferFilter, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Width="76" AutomationProperties.AutomationId="TxtToolFilter"
                             ToolTip="按机台号筛选" Text="{Binding ToolFilter, UpdateSourceTrigger=PropertyChanged}"/>
                </WrapPanel>
                <DataGrid Grid.Row="2" Margin="10,4,10,6" AutoGenerateColumns="False"
                          ItemsSource="{Binding Wafers}" SelectedItem="{Binding SelectedWafer}"
                          AutomationProperties.AutomationId="GridWafers" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Wafer" Width="*" Binding="{Binding WaferId}"/>
                        <DataGridTextColumn Header="Lot" Width="*" Binding="{Binding LotId}"/>
                        <DataGridTextColumn Header="机台" Width="44" Binding="{Binding ToolId}"/>
                        <DataGridTextColumn Header="设计Die" Width="56" Binding="{Binding DesignDieCount}"/>
                        <DataGridTextColumn Header="缺陷" Width="44" Binding="{Binding PreReviewDefectCount}"/>
                        <DataGridTextColumn Header="复判数" Width="44" Binding="{Binding ReviewedCount}"/>
                        <DataGridTextColumn Header="复判后良率" Width="70" Binding="{Binding PostReviewYieldText}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="3" Margin="10,2,10,10" FontSize="10.5" Foreground="{StaticResource Warn}"
                           TextWrapping="Wrap" AutomationProperties.AutomationId="TxtSimNotice">
                    [模拟结果] 设备采集 / AI 推理未接入（T-029 / T-035），结果确定性合成，不伪造设备成功。
                </TextBlock>
            </Grid>
        </Border>

        <!-- 中：复判全景 Map（复用 H05 MapGridView，关闭 AC-H05-04） -->
        <Border Style="{StaticResource Card}" Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,0">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock Text="复判全景 Map" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="B-06 / AC-H05-04 / BR-53" Style="{StaticResource PanelSub}" Margin="8,0,0,0"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8">
                    <views:MapGridView Model="{Binding Map}" AutomationProperties.AutomationId="MapRecheck"/>
                </Grid>
                <StackPanel Grid.Row="2" Margin="10,4,10,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="生成/载入 Map" Style="{StaticResource GhostButton}" Height="28" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="BtnGenerateMap" Command="{Binding GenerateMapCommand}"/>
                        <hc:NumericUpDown Width="44" Height="28" Margin="0,0,4,0" AutomationProperties.AutomationId="TxtJumpX"
                                 Value="{Binding JumpX, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringToDouble}}" Minimum="-100000" Maximum="1000000" DecimalPlaces="2"/>
                        <hc:NumericUpDown Width="44" Height="28" Margin="0,0,8,0" AutomationProperties.AutomationId="TxtJumpY"
                                 Value="{Binding JumpY, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringToDouble}}" Minimum="-100000" Maximum="1000000" DecimalPlaces="2"/>
                        <Button Content="X/Y 跳转" Style="{StaticResource GhostButton}" Height="28" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="BtnJump" Command="{Binding JumpToDieCommand}"/>
                        <Button Content="刷新图谱" Style="{StaticResource GhostButton}" Height="28"
                                AutomationProperties.AutomationId="BtnRefreshMap" Command="{Binding RefreshMapCommand}"/>
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource Text2}" AutomationProperties.AutomationId="TxtMapStatus">
                        <Run Text="{Binding MapStatusText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{StaticResource Text2}" AutomationProperties.AutomationId="TxtSelectedDie">
                        <Run Text="{Binding SelectedDieText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock FontSize="11" Foreground="{StaticResource Text3}" AutomationProperties.AutomationId="TxtRevision">
                        <Run Text="{Binding RevisionText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右：良率 + 复判执行 + 缺陷列表 -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 良率面板（F-3.9.2-07/08/09） -->
            <Border Style="{StaticResource Card}" Grid.Row="0" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <TextBlock Text="良率统计" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" AutomationProperties.AutomationId="TxtYieldSummary">
                        <Run Text="{Binding YieldSummaryText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource Text2}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="TxtRecheckMessage">
                        <Run Text="{Binding RecheckMessage, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Margin="0,4,0,0" FontSize="10.5" Foreground="{StaticResource Text3}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="TxtDeferredNote">
                        <Run Text="{Binding DeferredNote, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 复判执行（B-16 / B-11 快捷键 / AC-H05-02） -->
            <Border Style="{StaticResource Card}" Grid.Row="1" Margin="0,0,0,12" Padding="12">
                <StackPanel>
                    <TextBlock Text="复判执行" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource Text2}" TextWrapping="Wrap" Margin="0,0,0,6"
                               AutomationProperties.AutomationId="TxtDetail">
                        <Run Text="{Binding DetailText, Mode=OneWay}"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <hc:ComboBox Width="150" Margin="0,0,6,0" AutomationProperties.AutomationId="CmbRecheckBin"
                                  ItemsSource="{Binding AvailableBins}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding RecheckBin}"/>
                        <Button Content="人工复判选中 Die" Style="{StaticResource GhostButton}" Height="28"
                                AutomationProperties.AutomationId="BtnRecheckSelected" Command="{Binding RecheckSelectedCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <hc:ComboBox Width="74" Margin="0,0,4,0" AutomationProperties.AutomationId="CmbSourceBin"
                                  ItemsSource="{Binding AvailableBins}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding SourceBin}"/>
                        <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <hc:ComboBox Width="74" Margin="0,0,6,0" AutomationProperties.AutomationId="CmbTargetBin"
                                  ItemsSource="{Binding AvailableBins}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding TargetBin}"/>
                        <Button Content="批量复判" Style="{StaticResource GhostButton}" Height="28"
                                AutomationProperties.AutomationId="BtnBatchRecheck" Command="{Binding BatchRecheckCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox Width="60" Height="28" Margin="0,0,4,0" AutomationProperties.AutomationId="TxtShortcutKey"
                                 Text="{Binding ShortcutKey, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="应用快捷键复判" Style="{StaticResource GhostButton}" Height="28" Margin="0,0,6,0"
                                AutomationProperties.AutomationId="BtnApplyShortcut" Command="{Binding ApplyShortcutCommand}"/>
                        <Button Content="AI 复判（全片）" Style="{StaticResource GhostButton}" Height="28"
                                AutomationProperties.AutomationId="BtnAiRecheck" Command="{Binding AiRecheckCommand}"/>
                    </StackPanel>

                    <Button Content="AI 重新推理（R-H08-07）" Style="{StaticResource GhostButton}" Height="28"
                            Margin="0,0,0,6" AutomationProperties.AutomationId="BtnAiReinfer" Command="{Binding AiReinferCommand}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="TxtAiReinferMessage">
                        <Run Text="{Binding AiReinferMessage, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 缺陷列表（B-23，消费 H04 唯一 DefectRecord） -->
            <Border Style="{StaticResource Card}" Grid.Row="2" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="缺陷列表（多维筛选）" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox Width="110" Margin="0,0,6,0" AutomationProperties.AutomationId="TxtCategoryFilter"
                                 ToolTip="按缺陷类别筛选" Text="{Binding CategoryFilter, UpdateSourceTrigger=PropertyChanged}"/>
                        <hc:ComboBox Width="110" AutomationProperties.AutomationId="CmbReviewStateFilter"
                                  ItemsSource="{Binding ReviewStateOptions}" SelectedItem="{Binding ReviewStateFilter}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" AutoGenerateColumns="False" ItemsSource="{Binding Defects}"
                              AutomationProperties.AutomationId="GridDefects" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="区域" Width="44" Binding="{Binding Zone}"/>
                            <DataGridTextColumn Header="类别" Width="*" Binding="{Binding Category}"/>
                            <DataGridTextColumn Header="行列" Width="64" Binding="{Binding Row}"/>
                            <DataGridTextColumn Header="列" Width="40" Binding="{Binding Column}"/>
                            <DataGridTextColumn Header="面积" Width="56" Binding="{Binding Area}"/>
                            <DataGridTextColumn Header="复判状态" Width="64" Binding="{Binding ReviewState}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 结果输出（B-13 / B-14 / R-H08-06）：统一导出入口 + 复制动作 -->
            <Border Style="{StaticResource Card}" Grid.Row="3" Padding="12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="结果输出" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="B-13 / B-14 / R-H08-06" Style="{StaticResource PanelSub}" Margin="8,0,0,0"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <hc:ComboBox Width="216" Margin="0,0,6,0" AutomationProperties.AutomationId="CmbExportTarget"
                                  ItemsSource="{Binding ExportTargets}" DisplayMemberPath="Display"
                                  SelectedItem="{Binding SelectedExportTarget}"/>
                        <Button Content="导出 / 生成" Style="{StaticResource GhostButton}" Height="28"
                                AutomationProperties.AutomationId="BtnExportResult" Command="{Binding ExportResultCommand}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="复制 WaferId" Style="{StaticResource GhostButton}" Height="28" Margin="0,0,6,0"
                                AutomationProperties.AutomationId="BtnCopyWaferId" Command="{Binding CopyWaferIdCommand}"/>
                        <Button Content="复制相对路径" Style="{StaticResource GhostButton}" Height="28"
                                AutomationProperties.AutomationId="BtnCopyRelPath" Command="{Binding CopyRelativePathCommand}"/>
                    </StackPanel>
                    <TextBlock FontSize="11" Foreground="{StaticResource Text2}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="TxtExportMessage">
                        <Run Text="{Binding ExportMessage, Mode=OneWay}"/>
                    </TextBlock>
                    <Button Content="生成 Sinf（B-12）" Style="{StaticResource GhostButton}" Height="28"
                            Margin="0,6,0,4" AutomationProperties.AutomationId="BtnGenerateSinf" Command="{Binding GenerateSinfCommand}"/>
                    <TextBlock FontSize="11" Foreground="{StaticResource Warn}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="TxtSinfGenMessage">
                        <Run Text="{Binding SinfGenMessage, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部：按 Die 查看（R-H08-05）+ GoldenDie / 回溯图 / 复判图（F-3.9.3-20/23） -->
        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 按 Die 查看（R-H08-05） -->
            <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,12,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="按 Die 查看" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="R-H08-05 / BR-52 / BR-73" Style="{StaticResource PanelSub}" Margin="8,0,0,0"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="22" Height="22" Margin="0,0,8,0" BorderBrush="{StaticResource LineStrong}"
                                BorderThickness="1" Background="{Binding SelectedDieBrush}"/>
                        <TextBlock FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="TxtDieDetail">
                            <Run Text="{Binding DieDetailText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="←" Width="30" Height="28" Style="{StaticResource GhostButton}" Margin="0,0,4,0"
                                    AutomationProperties.AutomationId="BtnDieLeft" Command="{Binding MoveSelectionCommand}" CommandParameter="Left"/>
                            <Button Content="↑" Width="30" Height="28" Style="{StaticResource GhostButton}" Margin="0,0,4,0"
                                    AutomationProperties.AutomationId="BtnDieUp" Command="{Binding MoveSelectionCommand}" CommandParameter="Up"/>
                            <Button Content="↓" Width="30" Height="28" Style="{StaticResource GhostButton}" Margin="0,0,4,0"
                                    AutomationProperties.AutomationId="BtnDieDown" Command="{Binding MoveSelectionCommand}" CommandParameter="Down"/>
                            <Button Content="→" Width="30" Height="28" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="BtnDieRight" Command="{Binding MoveSelectionCommand}" CommandParameter="Right"/>
                            <TextBlock FontSize="11" Foreground="{StaticResource Text2}" VerticalAlignment="Center">
                                <Run Text="当前 "/><Run Text="{Binding DieCoordinateText, Mode=OneWay}"/><Run Text="（方向键 / 箭头导航，BR-52：X=列 Y=行）"/>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Grid.Row="1" FontSize="11.5" Foreground="{StaticResource Text2}" Margin="0,0,0,4"
                                   AutomationProperties.AutomationId="TxtDieDefectHeader">
                            <Run Text="该 Die 缺陷（"/><Run Text="{Binding SelectedDieDefects.Count, Mode=OneWay}"/><Run Text=" 项）"/>
                        </TextBlock>
                        <DataGrid Grid.Row="2" AutoGenerateColumns="False" ItemsSource="{Binding SelectedDieDefects}"
                                  AutomationProperties.AutomationId="GridDieDefects" IsReadOnly="True" Margin="0,0,0,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="区域" Width="44" Binding="{Binding Zone}"/>
                                <DataGridTextColumn Header="类别" Width="*" Binding="{Binding Category}"/>
                                <DataGridTextColumn Header="长" Width="48" Binding="{Binding Length}"/>
                                <DataGridTextColumn Header="宽" Width="48" Binding="{Binding Width}"/>
                                <DataGridTextColumn Header="面积" Width="56" Binding="{Binding Area}"/>
                                <DataGridTextColumn Header="复判" Width="60" Binding="{Binding ReviewState}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>

            <!-- GoldenDie / 回溯图 / 复判图（F-3.9.3-20 / 23） -->
            <Border Style="{StaticResource Card}" Grid.Column="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="GoldenDie / 回溯图 / 复判图" Style="{StaticResource PanelTitle}"/>
                        <TextBlock Text="F-3.9.3-20/23" Style="{StaticResource PanelSub}" Margin="8,0,0,0"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <Border Height="120" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Background="{StaticResource Surface3}" AutomationProperties.AutomationId="ImgGoldenDie">
                                <TextBlock Text="GoldenDie" FontSize="11" Foreground="{StaticResource Text3}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6"/>
                            </Border>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="TxtGoldenDie">
                                <Run Text="{Binding GoldenDieText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <Border Height="120" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Background="{StaticResource Surface3}" AutomationProperties.AutomationId="ImgBacktrack">
                                <TextBlock Text="回溯图" FontSize="11" Foreground="{StaticResource Text3}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6"/>
                            </Border>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="TxtBacktrackImage">
                                <Run Text="{Binding BacktrackImageText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Height="120" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                    Background="{StaticResource Surface3}" AutomationProperties.AutomationId="ImgRecheck">
                                <TextBlock Text="复判图" FontSize="11" Foreground="{StaticResource Text3}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="6"/>
                            </Border>
                            <TextBlock FontSize="10.5" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       AutomationProperties.AutomationId="TxtRecheckImage">
                                <Run Text="{Binding RecheckImageText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
