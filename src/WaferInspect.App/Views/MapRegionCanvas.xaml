<UserControl x:Class="WaferInspectHMI.Views.MapRegionCanvas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="400" Height="400" FontFamily="Segoe UI, Microsoft YaHei">
    <!--
      H04 共享 Map 圈选画布（B-01/B-02）：向导步骤 5/6 与参数验证页复用同一控件，
      数据只来自 IRoiScanAreaStore 的快照（State="{Binding Map}"），
      交互统一回调 IMapRegionCanvasHost.AddRegion / ToggleDie，不在此另存配置。
      20×20 Die 网格由 code-behind 一次性绘制到单张 WriteableBitmap：
      既避免 ItemsControl 容器重建，也避免 400 个子元素进入可视化 / 自动化树。
    -->
    <Border Background="{StaticResource Surface3}" BorderBrush="{StaticResource LineStrong}"
            BorderThickness="1" CornerRadius="4" Width="400" Height="400">
        <Grid x:Name="CanvasRoot" Width="400" Height="400" Background="Transparent"
              PreviewMouseLeftButtonDown="CanvasRoot_PreviewMouseLeftButtonDown"
              MouseMove="CanvasRoot_MouseMove"
              MouseLeftButtonUp="CanvasRoot_MouseLeftButtonUp">
            <Image x:Name="MapImage" Width="400" Height="400" Stretch="None" IsHitTestVisible="False"
                   HorizontalAlignment="Left" VerticalAlignment="Top"/>
            <Rectangle x:Name="SelRect" Stroke="#1D4FD1" StrokeThickness="2" Fill="#332563EB"
                       Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Left"
                       VerticalAlignment="Top"/>
        </Grid>
    </Border>
</UserControl>
