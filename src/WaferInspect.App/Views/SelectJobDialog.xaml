<Window x:Class="WaferInspectHMI.Views.SelectJobDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择 Job" Width="620" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Surface}" FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="选择 Job" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock Text="F-3.1.5-06：浮窗列出全部配方名称，支持多选；BR-10：多选后按顺序依次执行。"
                       FontSize="11.5" Foreground="{StaticResource Text3}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Job / 配方名称" Style="{StaticResource MetaText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Wafer 尺寸" Style="{StaticResource MetaText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="Die 尺寸 X × Y" Style="{StaticResource MetaText}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="JobList" ItemsSource="{Binding Options}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="10,0" Height="34">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="1.4*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Job.JobName}" FontSize="12" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding WaferSizeText}" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding DieSizeText}" FontSize="12" Foreground="{StaticResource Text2}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="提示：多选后点「应用」，系统按选择顺序依次执行（BR-10）。" FontSize="11" Foreground="{StaticResource Text3}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" AutomationProperties.AutomationId="BtnJobCancel" Style="{StaticResource GhostButton}" Width="88" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="应用" AutomationProperties.AutomationId="BtnJobApply" Style="{StaticResource PrimaryButton}" Width="88" Click="Apply_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
