<Window x:Class="WaferInspectHMI.Views.JobInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="查看 Job" Width="520" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Surface}" FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TitleText" Text="Job" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock Text="F-3.1.5-08：查看 JobName 对应配方的全流程信息（配方明细归 H02，P2 迁移）。"
                       FontSize="11.5" Foreground="{StaticResource Text3}" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Job 名称" Style="{StaticResource MetaText}"/>
                            <TextBlock x:Name="JobNameText" FontSize="13" Foreground="{StaticResource Text}" Margin="0,3,0,8"/>
                            <TextBlock Text="Wafer 尺寸" Style="{StaticResource MetaText}"/>
                            <TextBlock x:Name="WaferSizeText" FontSize="13" Foreground="{StaticResource Text}" Margin="0,3,0,8"/>
                            <TextBlock Text="检测片数" Style="{StaticResource MetaText}"/>
                            <TextBlock x:Name="WaferCountText" FontSize="13" Foreground="{StaticResource Text}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Recipe" Style="{StaticResource MetaText}"/>
                            <TextBlock x:Name="RecipeText" FontSize="13" Foreground="{StaticResource Text}" Margin="0,3,0,8"/>
                            <TextBlock Text="Die 尺寸 X" Style="{StaticResource MetaText}"/>
                            <TextBlock x:Name="DieXText" FontSize="13" Foreground="{StaticResource Text}" Margin="0,3,0,8"/>
                            <TextBlock Text="Die 尺寸 Y" Style="{StaticResource MetaText}"/>
                            <TextBlock x:Name="DieYText" FontSize="13" Foreground="{StaticResource Text}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="全流程（F-3.1.10）" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text2}" Margin="0,0,0,6"/>
                <Border Style="{StaticResource Card}" Padding="12">
                    <TextBlock x:Name="FlowText" FontSize="12" Foreground="{StaticResource Text2}" TextWrapping="Wrap" LineHeight="20"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="关闭" Style="{StaticResource GhostButton}" Width="88"
                HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click"/>
    </Grid>
</Window>
