<UserControl x:Class="WaferInspectHMI.Views.DefectAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:WaferInspectHMI.Views"
             FontFamily="Segoe UI, Microsoft YaHei" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Width" Value="72"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 页头：子配方选择 + 参数验证入口 -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock Text="算法参数调试" Style="{StaticResource PanelTitle}" DockPanel.Dock="Left" Margin="0,0,14,0"/>
                    <TextBlock Text="子配方：" VerticalAlignment="Center" Foreground="{StaticResource Text2}"/>
                    <ComboBox Width="240" Margin="0,0,8,0" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"
                              DisplayMemberPath="Display"
                              AutomationProperties.AutomationId="ComboH04Recipe"/>
                    <Button Content="打开参数验证页…" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                            Command="{Binding OpenValidationCommand}"
                            AutomationProperties.AutomationId="BtnOpenValidation"/>
                    <Button Content="刷新" Style="{StaticResource GhostButton}" Command="{Binding RefreshViewCommand}"
                            AutomationProperties.AutomationId="BtnH04Refresh"/>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource PanelSub}" Margin="12,0,0,0"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="H04StatusText"/>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：共享 Map 圈选画布（AC-P2-03：向导步骤 5/6 与参数验证页同一份区域） -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Map 扫描区域（H04 唯一数据源）" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="拖拽圈选 · 双击抽检" Style="{StaticResource PanelSub}" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <views:MapRegionCanvas HorizontalAlignment="Left" State="{Binding Map}"
                                               AutomationProperties.AutomationId="H04MapCanvas"/>
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox IsChecked="{Binding ScanFullWafer}" Content="全片扫描（BR-37 默认）"
                                      VerticalAlignment="Center" Margin="0,0,12,0"
                                      AutomationProperties.AutomationId="ChkH04FullWafer"/>
                            <CheckBox IsChecked="{Binding SamplingEnabled}" Content="抽检（双击 Die，BR-38）"
                                      VerticalAlignment="Center"
                                      AutomationProperties.AutomationId="ChkH04Sampling"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="起始列" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding RegionX}"
                                         AutomationProperties.AutomationId="FieldH04X"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="起始行" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding RegionY}"
                                         AutomationProperties.AutomationId="FieldH04Y"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="列数" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding RegionW}"
                                         AutomationProperties.AutomationId="FieldH04W"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="行数" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding RegionH}"
                                         AutomationProperties.AutomationId="FieldH04H"/>
                            </StackPanel>
                            <Button Content="添加区域" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom"
                                    Command="{Binding AddRegionFromFieldsCommand}"
                                    AutomationProperties.AutomationId="BtnH04AddRegion"/>
                            <Button Content="清除区域" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Margin="8,0,0,0"
                                    Command="{Binding ClearRegionsCommand}"
                                    AutomationProperties.AutomationId="BtnH04ClearRegions"/>
                        </WrapPanel>
                        <TextBlock Text="已定义扫描区域：" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                        <ItemsControl ItemsSource="{Binding Map.Regions}" MaxHeight="96"
                                      AutomationProperties.AutomationId="H04RegionList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Tip}" Style="{StaticResource KeyText}" Margin="0,0,0,3"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 右：ROI/参数摘要 + 缺陷结果（B-23 统一 DefectRecord） -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="ROI 与算法参数（T-014 可扩展集合）" Style="{StaticResource PanelTitle}"/>
                                <Button Content="加载图片文件夹…" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                        Command="{Binding LoadFolderCommand}"
                                        AutomationProperties.AutomationId="BtnH04LoadFolder"/>
                            </DockPanel>
                            <TextBlock Text="{Binding FolderText}" Style="{StaticResource MetaText}"
                                       AutomationProperties.AutomationId="H04FolderText"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="ROI 区域（步骤 5）" Style="{StaticResource FieldLabel}"/>
                                    <ItemsControl ItemsSource="{Binding RoiZoneRows}" MaxHeight="110"
                                                  AutomationProperties.AutomationId="H04RoiList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource KeyText}" Margin="0,0,0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="算法参数（检测 / 量测 / 全局）" Style="{StaticResource FieldLabel}"/>
                                    <ItemsControl ItemsSource="{Binding ParameterRows}" MaxHeight="110"
                                                  AutomationProperties.AutomationId="H04ParameterList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource KeyText}" Margin="0,0,0,2">
                                                    <Run Text="{Binding Key, Mode=OneWay}"/>
                                                    <Run Text=" = "/>
                                                    <Run Text="{Binding Value, Mode=OneWay}"/>
                                                    <Run Text="{Binding Unit, Mode=OneWay}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="缺陷结果列表（F-3.8.1-08 / B-23 统一模型）"
                                       Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding DefectResults}" Style="{StaticResource GenericGrid}"
                                      SelectedItem="{Binding SelectedDefect, Mode=TwoWay}" MinHeight="140"
                                      AutoGenerateColumns="False" AutomationProperties.AutomationId="H04DefectGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="区域" Binding="{Binding Zone}" Width="90"/>
                                    <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="70"/>
                                    <DataGridTextColumn Header="行" Binding="{Binding Row}" Width="45"/>
                                    <DataGridTextColumn Header="列" Binding="{Binding Column}" Width="45"/>
                                    <DataGridTextColumn Header="长 μm" Binding="{Binding Length}" Width="65"/>
                                    <DataGridTextColumn Header="宽 μm" Binding="{Binding Width}" Width="65"/>
                                    <DataGridTextColumn Header="面积 μm²" Binding="{Binding Area}" Width="80"/>
                                    <DataGridTextColumn Header="复判状态" Binding="{Binding ReviewState}" Width="80"/>
                                    <DataGridTextColumn Header="原始图片路径" Binding="{Binding SourceImagePath}" Width="160"/>
                                    <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="220"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                                <TextBlock Text="原始图片路径（F-3.8.1-09）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding OriginalImagePath, Mode=OneWay}" IsReadOnly="True"
                                         Height="28" Padding="8,0" VerticalContentAlignment="Center"
                                         AutomationProperties.AutomationId="H04OriginalImage"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 页脚：同步证据、调试闭环与设备搁置说明 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding SyncText}" Style="{StaticResource KeyText}"
                               AutomationProperties.AutomationId="H04SyncText"/>
                    <TextBlock Text="{Binding ClosedLoopText}" Style="{StaticResource MetaText}" Margin="0,6,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DeviceNote}" Foreground="{StaticResource Warn}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
