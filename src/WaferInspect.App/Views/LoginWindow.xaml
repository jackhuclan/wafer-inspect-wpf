<Window x:Class="WaferInspectHMI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WaferInspect · 用户登录"
        Width="440" Height="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True"
        ShowInTaskbar="False">

    <!-- 登录门禁承载（AC-P0-04）：深色 chrome + 白色登录卡片，与主窗口主题一致。 -->
    <Border Background="#0D1826" CornerRadius="12" BorderBrush="#1D2E48" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 无边框标题栏：可拖拽，右侧关闭按钮 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_Down">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="WaferInspect · 用户登录" FontSize="11.5"
                           Foreground="#8299B6" Margin="18,12,0,10" VerticalAlignment="Center"/>
                <Button Grid.Column="1" AutomationProperties.AutomationId="LoginCloseButton" Content="✕" Width="40" Height="34"
                        Foreground="#BACADF" Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Click="Close_Click" ToolTip="退出登录"/>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource Surface}" CornerRadius="10"
                    Margin="20,4,20,20" Padding="34,30">
                <StackPanel>
                    <TextBlock Text="WaferInspect" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Text}"/>
                    <TextBlock Text="晶圆检测上位机 · 统一身份登录" FontSize="12"
                               Foreground="{StaticResource Text3}" Margin="0,6,0,26"/>

                    <TextBlock Text="用户编号" FontSize="12" Foreground="{StaticResource Text2}" Margin="0,0,0,6"/>
                    <TextBox x:Name="UserIdBox" AutomationProperties.AutomationId="LoginUserIdBox" Height="36"
                             Padding="10,0" VerticalContentAlignment="Center" FontSize="13"
                             Text="{Binding UserId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="密码" FontSize="12" Foreground="{StaticResource Text2}" Margin="0,14,0,6"/>
                    <PasswordBox x:Name="PasswordBox" AutomationProperties.AutomationId="LoginPasswordBox" Height="36"
                                 Padding="10,0" VerticalContentAlignment="Center" FontSize="13"
                                 KeyDown="PasswordBox_KeyDown" PasswordChanged="OnPasswordChanged"/>

                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" Foreground="{StaticResource Danger}"
                               Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <Button AutomationProperties.AutomationId="LoginSubmitButton" Content="登 录" Height="38" FontSize="14"
                            Style="{StaticResource PrimaryButton}" Command="{Binding LoginCommand}"
                            IsDefault="True" Margin="0,18,0,0"/>
                    <Button AutomationProperties.AutomationId="LoginCancelButton" Content="退出程序" Height="32" FontSize="12.5"
                            Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}"
                            Margin="0,10,0,0"/>

                    <TextBlock Text="登录一次即可访问检测任务与数据分析全部模块" FontSize="10.5"
                               Foreground="{StaticResource Text3}" Margin="0,20,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
