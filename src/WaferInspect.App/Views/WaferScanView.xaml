<UserControl x:Class="WaferInspectHMI.Views.WaferScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WaferInspectHMI.ViewModels.Modules"
             xmlns:views="clr-namespace:WaferInspectHMI.Views"
             xmlns:services="clr-namespace:WaferInspectHMI.Services"
             xmlns:alignment="clr-namespace:WaferInspect.Core.Alignment;assembly=WaferInspect.Core"
             FontFamily="Segoe UI, Microsoft YaHei" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="FieldItem" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,8"/>
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <views:FlowStepStatusToTextConverter x:Key="FlowStepStatusToText"/>
        <views:FlowStepStatusToBrushConverter x:Key="FlowStepStatusToBrush"/>
        <views:BoolToCnConverter x:Key="BoolToCn"/>
        <views:SinfKindToTextConverter x:Key="SinfKindToText"/>
        <views:SinfKindToEnabledConverter x:Key="SinfKindToEnabled"/>
        <views:ScanKindToTextConverter x:Key="ScanKindToText"/>
        <views:ScanKindToEnabledConverter x:Key="ScanKindToEnabled"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 扫描参数区（F-3.7.3-01/06/09/15，BR-46/47/48） -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="扫描参数" Style="{StaticResource PanelTitle}" Margin="0,0,12,0"/>
                        <TextBlock Text="本地配置 · 扫描执行与对位能力属 H06/H03（T-029/T-035）" Style="{StaticResource MetaText}"
                                   HorizontalAlignment="Right" TextWrapping="Wrap"/>
                    </DockPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <StackPanel Style="{StaticResource FieldItem}">
                            <TextBlock Text="晶圆大小（BR-46）" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Width="120" Style="{StaticResource FieldCombo}" IsEditable="False"
                                      ItemsSource="{Binding WaferSizeOptions}" SelectedItem="{Binding WaferSize, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="ComboWaferSize"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldItem}">
                            <TextBlock Text="扫描速度（BR-47，100–500）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="120" Style="{StaticResource FieldBox}" Text="{Binding ScanSpeed, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="FieldScanSpeed"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldItem}">
                            <TextBlock Text="创建方式（F-3.7.3-09）" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Width="170" Style="{StaticResource FieldCombo}" IsEditable="False"
                                      ItemsSource="{Binding CreateModeOptions}" SelectedItem="{Binding CreateMode, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="ComboCreateMode"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldItem}">
                            <TextBlock Text="是否扩膜（BR-48）" Style="{StaticResource FieldLabel}"/>
                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding ExpandFilm, Mode=TwoWay}"
                                      Content="切割后扩膜晶圆" AutomationProperties.AutomationId="CheckExpandFilm"/>
                        </StackPanel>
                        <Button Content="应用参数" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="28"
                                Command="{Binding ApplyScanParamsCommand}" AutomationProperties.AutomationId="BtnApplyScanParams"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                </Grid.ColumnDefinitions>

                <!-- 左：Map 编辑工具（R-H05-05） -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Map 编辑工具（Wafer 扫描，唯一 MapGridView）" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="{Binding RevisionText}" Style="{StaticResource MetaText}" HorizontalAlignment="Right"
                                       AutomationProperties.AutomationId="ScanRevisionText"/>
                        </DockPanel>
                        <views:MapGridView x:Name="MapControl" Model="{Binding Map}"
                                           BrushBin="{Binding BrushBinDef}" BatchMode="{Binding IsBatchMode}"
                                           InkMode="{Binding IsInkMode}"
                                           HorizontalAlignment="Left"
                                           AutomationProperties.AutomationId="ScanMap"/>
                        <TextBlock Text="{Binding MapStatusText}" Style="{StaticResource KeyText}" Margin="0,8,0,0"
                                   AutomationProperties.AutomationId="ScanMapStatus"/>
                        <TextBlock Text="{Binding SelectedDieText}" Style="{StaticResource KeyText}" Margin="0,4,0,0"
                                   AutomationProperties.AutomationId="ScanSelectedDie"/>
                        <TextBlock Text="提示：选中笔刷后在 Map 上双击改单个 Die；开启「批量模式」后拖拽框选区域统一改 Bin。"
                                   Style="{StaticResource KeyText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="生成 Map 图" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"
                                    Command="{Binding GenerateMapCommand}" AutomationProperties.AutomationId="BtnScanGenerateMap"/>
                            <Button Content="刷新图谱" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding RefreshMapCommand}" AutomationProperties.AutomationId="BtnScanRefreshMap"/>
                            <Button Content="整行" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding EditRowCommand}" AutomationProperties.AutomationId="BtnScanEditRow"/>
                            <Button Content="整列" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding EditColumnCommand}" AutomationProperties.AutomationId="BtnScanEditColumn"/>
                            <Button Content="批量模式" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding ToggleBatchCommand}" AutomationProperties.AutomationId="BtnScanBatchMode"
                                    ToolTip="开启后在 Map 上拖拽框选区域批量修改"/>
                            <Button Content="外扩" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding ExpandCommand}" AutomationProperties.AutomationId="BtnScanExpand"/>
                            <Button Content="内缩" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding ShrinkCommand}" AutomationProperties.AutomationId="BtnScanShrink"/>
                            <Button Content="Ink 笔刷" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding ToggleInkCommand}" AutomationProperties.AutomationId="BtnScanInk"
                                    ToolTip="开启后在 Map 上单击 Die 切换墨点（BR-49，物理墨点属性）"/>
                            <Button Content="清除 Ink" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding ClearInkCommand}" AutomationProperties.AutomationId="BtnScanClearInk"
                                    ToolTip="清除全部 Ink 墨点标记"/>
                            <StackPanel Margin="0,0,6,6" VerticalAlignment="Bottom">
                                <TextBlock Text="Sinf 导出格式（T-037）" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox Width="180" Style="{StaticResource FieldCombo}" ItemsSource="{Binding SinfExporterOptions}"
                                              SelectedItem="{Binding SelectedSinfExporterKind, Mode=TwoWay}"
                                              AutomationProperties.AutomationId="ComboSinfFormat"
                                              ToolTip="工业 Sinf 字节流因 T-037 规范待确认暂不可选；实现 IndustrialSinfExporter.Export 后启用">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type services:SinfExporterKind}">
                                                <TextBlock Text="{Binding Converter={StaticResource SinfKindToText}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="ComboBoxItem">
                                                <Setter Property="IsEnabled" Value="{Binding Converter={StaticResource SinfKindToEnabled}}"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                    </ComboBox>
                                    <Button Content="导出 Sinf" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0"
                                            Command="{Binding ExportSinfCommand}" AutomationProperties.AutomationId="BtnScanExportSinf"
                                            ToolTip="经可插拔 ISinfExporter 导出：默认内部 CSV（非工业字节流，T-037 待确认）"/>
                                </StackPanel>
                            </StackPanel>
                        </WrapPanel>
                        <WrapPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="内缩大小（F-3.7.3-21）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Width="70" Style="{StaticResource FieldBox}" Text="{Binding ShrinkStep, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.AutomationId="FieldShrinkStep"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="X（列）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Width="70" Style="{StaticResource FieldBox}" Text="{Binding JumpX}"
                                         AutomationProperties.AutomationId="FieldScanJumpX"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Y（行）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Width="70" Style="{StaticResource FieldBox}" Text="{Binding JumpY}"
                                         AutomationProperties.AutomationId="FieldScanJumpY"/>
                            </StackPanel>
                            <Button Content="X/Y 跳转" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Height="28"
                                    Command="{Binding JumpToDieCommand}" AutomationProperties.AutomationId="BtnScanJump"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 右：图谱类型 / 笔刷调色板 / 全景图 -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="图谱类型（F-3.7.3-11，B-11 唯一数据源）" Style="{StaticResource PanelTitle}"/>
                        <ComboBox Margin="0,8,0,10" Style="{StaticResource FieldCombo}" IsEditable="False"
                                  ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                                  DisplayMemberPath="Display"
                                  AutomationProperties.AutomationId="ComboScanMapType"/>
                        <TextBlock Text="笔刷 Bin（双击 / 批量 / 外扩内缩使用的目标 Bin）" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                        <ListBox Height="180" ItemsSource="{Binding BrushBins}" SelectedItem="{Binding SelectedBrushBin, Mode=TwoWay}"
                                 AutomationProperties.AutomationId="ScanBrushBins">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BrushBinItem}">
                                    <Border Background="{StaticResource Surface3}" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <Rectangle Width="20" Height="20" Fill="{Binding ColorHex}" Stroke="{StaticResource LineStrong}" StrokeThickness="1"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Display}" VerticalAlignment="Center" Style="{StaticResource KeyText}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="全景图（F-3.7.3-10）" Style="{StaticResource PanelTitle}" Margin="0,12,0,6"/>
                        <Border Background="{StaticResource Surface3}" CornerRadius="6" Padding="12" Height="120">
                            <TextBlock Text="{Binding PanoramaText}" Style="{StaticResource KeyText}" TextWrapping="Wrap"
                                       VerticalAlignment="Center" AutomationProperties.AutomationId="ScanPanoramaText"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 页脚：状态与未迁移登记 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource KeyText}" Margin="0,0,0,6"
                               AutomationProperties.AutomationId="ScanStatusText"/>
                    <TextBlock Text="{Binding DeferredNote}" Foreground="{StaticResource Warn}" FontSize="11.5"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 12 步流程编排（B-24 / F-3.7.3-25）：本地步可交付，依赖 H03/H06 步诚实搁置 -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="12 步 Map 创建流程（B-24）" Style="{StaticResource PanelTitle}" Margin="0,0,12,0"/>
                        <TextBlock Text="{Binding FlowStatusText}" Style="{StaticResource MetaText}" HorizontalAlignment="Right"
                                   TextWrapping="Wrap" AutomationProperties.AutomationId="ScanFlowStatus"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左：步骤列表（自由跳转，BR-19） -->
                        <Border Grid.Column="0" Background="{StaticResource Surface3}" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="上一步" Style="{StaticResource GhostButton}" Command="{Binding GotoPrevCommand}"
                                            AutomationProperties.AutomationId="BtnFlowPrev"/>
                                    <Button Content="下一步" Style="{StaticResource GhostButton}" Margin="6,0"
                                            Command="{Binding GotoNextCommand}" AutomationProperties.AutomationId="BtnFlowNext"/>
                                    <Button Content="运行全流程" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding RunFlowCommand}" AutomationProperties.AutomationId="BtnFlowRun"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding FlowSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScanFlowStep}">
                                            <Button Margin="0,0,0,4" Padding="8,6" HorizontalContentAlignment="Stretch"
                                                    Command="{Binding DataContext.SelectStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Background="{StaticResource Surface2}">
                                                <DockPanel LastChildFill="True">
                                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                                             Fill="{Binding Status, Converter={StaticResource FlowStepStatusToBrush}}"/>
                                                    <TextBlock Text="{Binding StepNo, StringFormat='{}{0}. '}" VerticalAlignment="Center"
                                                               Style="{StaticResource KeyText}"/>
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Style="{StaticResource KeyText}"
                                                               TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 右：选中步骤详情（诚实标注依赖） -->
                        <Border Grid.Column="1" Background="{StaticResource Surface3}" CornerRadius="8" Padding="12">
                            <StackPanel DataContext="{Binding SelectedStep}">
                                <DockPanel>
                                    <TextBlock Text="{Binding StepNo, StringFormat='步骤 {0}'}" Style="{StaticResource PanelTitle}"/>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}" Margin="8,0,0,0"/>
                                    <Ellipse Width="14" Height="14" Fill="{Binding Status, Converter={StaticResource FlowStepStatusToBrush}}"
                                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="能力归属：" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Owner}" Style="{StaticResource KeyText}" Margin="4,0,18,0"/>
                                    <TextBlock Text="状态：" Style="{StaticResource FieldLabel}"/>
                                    <TextBlock Text="{Binding Status, Converter={StaticResource FlowStepStatusToText}}" Style="{StaticResource KeyText}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DependencyNote}" Style="{StaticResource KeyText}" Margin="0,10,0,0"
                                           TextWrapping="Wrap" Foreground="{StaticResource Warn}"
                                           Visibility="{Binding DependencyNote, Converter={StaticResource NonEmptyVis}}"/>
                                <TextBlock Text="{Binding ExportNote}" Style="{StaticResource KeyText}" Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ExportNote, Converter={StaticResource NonEmptyVis}}"/>
                                <Button Content="执行本步" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" HorizontalAlignment="Left"
                                        Command="{Binding DataContext.RunStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" AutomationProperties.AutomationId="BtnFlowRunStep"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- H03 参考图像（Golden Die 规划，B-09，P5 1.7.0）：本地确定性规划与落格，真实拟合属 H06（T-029 搁置） -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="H03 参考图像（Golden Die 规划，B-09）" Style="{StaticResource PanelTitle}" Margin="0,0,12,0"/>
                        <TextBlock Text="真实图像拟合属 H06（T-029 搁置，未伪造）" Style="{StaticResource MetaText}"
                                   HorizontalAlignment="Right" TextWrapping="Wrap"/>
                    </DockPanel>

                    <WrapPanel Margin="0,0,0,10">
                        <StackPanel Style="{StaticResource FieldItem}">
                            <TextBlock Text="参考 Die 数量（F-3.2.2-67）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="120" Style="{StaticResource FieldBox}" Text="{Binding ReferenceDieCount, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="FieldRefDieCount"/>
                        </StackPanel>
                        <StackPanel Style="{StaticResource FieldItem}">
                            <TextBlock Text="视野缩放 FOV（0~10，BR-30）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="120" Style="{StaticResource FieldBox}" Text="{Binding FovZoom, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="FieldFovZoom"/>
                        </StackPanel>
                        <Button Content="生成 Golden Die 规划" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="28"
                                Command="{Binding PlanGoldenDieCommand}" AutomationProperties.AutomationId="BtnPlanGoldenDie"/>
                        <Button Content="调整 FOV 重规划" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Height="28"
                                Command="{Binding ChangeFovZoomCommand}" AutomationProperties.AutomationId="BtnChangeFov"
                                ToolTip="BR-30：修改 FOV 后重新规划并标记 NeedsRegeneration"/>
                        <Button Content="标记手动调整" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Height="28"
                                Command="{Binding MarkManualAdjustCommand}" AutomationProperties.AutomationId="BtnMarkManualAdjust"
                                ToolTip="F-3.2.2-64/66：FOV 图谱手动调整（保留已规划点位）"/>
                        <Button Content="应用规划到 Map（落格 RD）" VerticalAlignment="Bottom" Height="28"
                                Command="{Binding ApplyGoldenDieToMapCommand}" AutomationProperties.AutomationId="BtnApplyGoldenDie"
                                ToolTip="把规划出的参考 Die 落格为 B-11 参考 Die（RD）">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGoldenPlan}" Value="False">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </WrapPanel>

                    <Border Background="{StaticResource Surface3}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="规划结果（B-09，本地确定性）" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="参考 Die（绿）：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding GoldenPlan.GreenCount, FallbackValue=0}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="待检测 Die（黄）：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding GoldenPlan.YellowCount, FallbackValue=0}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="预聚焦（蓝）：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding GoldenPlan.BlueCount, FallbackValue=0}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="参考 Die（红）：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding GoldenPlan.RedCount, FallbackValue=0}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="耗时指数 BR-29：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding GoldenPlan.EstimatedCostIndex, FallbackValue=0}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="当前 FOV：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding GoldenPlan.FovZoom, FallbackValue=0}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="需重生成 BR-30：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding GoldenPlan.NeedsRegeneration, Converter={StaticResource BoolToCn}, FallbackValue=否}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="手动调整 F-3.2.2-64/66：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding GoldenPlan.ManualAdjusted, Converter={StaticResource BoolToCn}, FallbackValue=否}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="规划出的参考 Die 坐标（前若干项）：" Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                            <ItemsControl ItemsSource="{Binding GoldenReferenceDieTexts}" MaxHeight="96">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Surface2}" CornerRadius="4" Padding="6,3" Margin="0,0,6,6">
                                            <TextBlock Text="{Binding}" Style="{StaticResource KeyText}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="诚实边界：真实参考图像采集 / 拟合属 H06（设备连接 T-029 搁置）。本面板仅在本地确定性规划参考 Die 与四色分类、并落格为 RD，不做任何图像采集 / 拟合，不伪造设备结果（E-08 / E-10）。"
                               Foreground="{StaticResource Warn}" FontSize="11.5" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- H06 扫描执行 / 对位（离线演算沙盒，T-029/T-035 诚实搁置，P6 1.8.0）：合成 FOV + B-08 引擎 + H03 对位，全部为确定性离线演算 -->
            <Border Grid.Row="5" Style="{StaticResource Card}" Padding="14,10" Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="H06 扫描执行 / 对位（离线演算，T-029/T-035 诚实搁置）" Style="{StaticResource PanelTitle}" Margin="0,0,12,0"/>
                        <TextBlock Text="合成 FOV + B-08 引擎 + H03 对位，确定性离线演算" Style="{StaticResource MetaText}"
                                   HorizontalAlignment="Right" TextWrapping="Wrap"/>
                    </DockPanel>

                    <WrapPanel Margin="0,0,0,10">
                        <StackPanel Style="{StaticResource FieldItem}">
                            <TextBlock Text="匹配阈值（BR-24，0~100）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="120" Style="{StaticResource FieldBox}" Text="{Binding MatchThreshold, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="FieldMatchThreshold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,8" VerticalAlignment="Bottom">
                            <TextBlock Text="扫描执行源（T-029/T-035）" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Width="200" Style="{StaticResource FieldCombo}" ItemsSource="{Binding ScanExecutorOptions}"
                                      SelectedItem="{Binding SelectedScanExecutorKind, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="ComboScanSource"
                                      ToolTip="真实设备扫描因 T-029/T-035 规范待确认暂不可选；实现 DeviceScanExecutor.Execute 后启用">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type alignment:ScanExecutorKind}">
                                        <TextBlock Text="{Binding Converter={StaticResource ScanKindToText}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="IsEnabled" Value="{Binding Converter={StaticResource ScanKindToEnabled}}"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                        </StackPanel>
                        <Button Content="运行离线扫描" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Height="28"
                                Command="{Binding RunOfflineScanCommand}" AutomationProperties.AutomationId="BtnRunOfflineScan"
                                ToolTip="合成 FOV 上真实跑 B-08 匹配引擎与 H03 对位（离线演算）"/>
                        <Button Content="降低分数重试" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Height="28"
                                Command="{Binding RetryLowerScoreCommand}" AutomationProperties.AutomationId="BtnRetryLowerScore"
                                ToolTip="步骤 8：同一合成 FOV 上用更低阈值重跑 B-08 引擎"/>
                        <Button Content="离线对位" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Height="28"
                                Command="{Binding RunOfflineAlignCommand}" AutomationProperties.AutomationId="BtnRunOfflineAlign"
                                ToolTip="H03 DieToPlatform 解参考 Die 平台坐标（离线演算）"/>
                    </WrapPanel>

                    <Border Background="{StaticResource Surface3}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="离线演算结果（H06，非真实设备）" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="是否离线：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding LastScanReport.IsOffline, Converter={StaticResource BoolToCn}, FallbackValue=否}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="匹配分数：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding LastScanReport.MatchScore, FallbackValue=0}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="是否通过：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding LastScanReport.MatchPassed, Converter={StaticResource BoolToCn}, FallbackValue=否}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="匹配阈值：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding LastScanReport.MatchThreshold, FallbackValue=0}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="平台 X (mm)：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding LastScanReport.PlatformX, FallbackValue=0}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="平台 Y (mm)：" Style="{StaticResource KeyText}" Width="120"/>
                                        <TextBlock Text="{Binding LastScanReport.PlatformY, FallbackValue=0}" Style="{StaticResource KeyText}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding ScanReportText}" Style="{StaticResource KeyText}" Margin="0,8,0,0"
                                       TextWrapping="Wrap" AutomationProperties.AutomationId="ScanOfflineReport"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource Surface3}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                        <TextBlock Text="诚实边界：本面板运行确定性离线演算——合成 FOV（SyntheticFovImage）+ B-08 唯一匹配引擎 + H03 MarkAlignmentService。未接入真实相机采集 / AI 推理（T-029/T-035 搁置），绝不注册生产 IDeviceGateway、绝不伪造设备扫描结果（E-08/E-10）。真实设备扫描需待 T-029/T-035 闭环后替换 FOV 来源。"
                                   Foreground="{StaticResource Warn}" FontSize="11.5" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
