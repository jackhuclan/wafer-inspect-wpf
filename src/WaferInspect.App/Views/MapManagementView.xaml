<UserControl x:Class="WaferInspectHMI.Views.MapManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WaferInspectHMI.ViewModels.Modules"
             xmlns:views="clr-namespace:WaferInspectHMI.Views"
             FontFamily="Segoe UI, Microsoft YaHei" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="FieldItem" TargetType="StackPanel">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="0,0,8,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 页头：F-3.7.1-01~02 / F-3.7.2-01~02 图谱类型 CRUD -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="MapType 编辑" Style="{StaticResource PanelTitle}" Margin="0,0,12,0"/>
                        <ComboBox Width="250" Margin="0,0,8,0" Style="{StaticResource FieldCombo}"
                                  ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                                  DisplayMemberPath="Display"
                                  AutomationProperties.AutomationId="ComboMapType"/>
                        <Button Content="新增" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                                Command="{Binding NewTypeCommand}" AutomationProperties.AutomationId="BtnMapNew"/>
                        <Button Content="复制" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                Command="{Binding DuplicateTypeCommand}" AutomationProperties.AutomationId="BtnMapDuplicate"/>
                        <Button Content="重命名" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                Command="{Binding RenameTypeCommand}" AutomationProperties.AutomationId="BtnMapRename"/>
                        <Button Content="删除" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                Command="{Binding DeleteTypeCommand}" AutomationProperties.AutomationId="BtnMapDelete"/>
                        <Button Content="保存" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                Command="{Binding SaveTypeCommand}" AutomationProperties.AutomationId="BtnMapSave"/>
                        <Button Content="刷新" Style="{StaticResource GhostButton}"
                                Command="{Binding RefreshTypesCommand}" AutomationProperties.AutomationId="BtnMapRefresh"/>
                    </DockPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="图谱类型名称" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="240" Style="{StaticResource FieldBox}" Text="{Binding TypeName}"
                                     AutomationProperties.AutomationId="FieldMapTypeName"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="图谱文件（BR-45 生成 Map 图前置）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="360" Style="{StaticResource FieldBox}" Text="{Binding MapFilePath}"
                                     AutomationProperties.AutomationId="FieldMapPath"/>
                        </StackPanel>
                        <Button Content="导入图谱文件…" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Height="28"
                                Command="{Binding ImportMapFileCommand}" AutomationProperties.AutomationId="BtnMapImport"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource KeyText}" Margin="12,6,0,0"
                                   VerticalAlignment="Center" AutomationProperties.AutomationId="MapStatusText"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="430"/>
                </Grid.ColumnDefinitions>

                <!-- 左：Bin 代码列表（F-3.7.2-03~10 / BR-43/44） -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Bin 代码列表（8 类固定枚举，全部字段可编辑）" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="{Binding FixedKindsText}" Style="{StaticResource MetaText}"
                                       HorizontalAlignment="Right" TextWrapping="Wrap" MaxWidth="360"/>
                        </DockPanel>
                        <WrapPanel Grid.Row="1" Margin="0,8,0,10">
                            <ComboBox Width="150" Style="{StaticResource FieldCombo}"
                                      ItemsSource="{Binding AvailableKindNames}" SelectedItem="{Binding NewBinKind, Mode=TwoWay}" IsEditable="False"
                                      AutomationProperties.AutomationId="ComboNewBinKind"/>
                            <Button Content="增加 Bin 代码" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                    Command="{Binding AddBinCodeCommand}" AutomationProperties.AutomationId="BtnAddBinCode"/>
                        </WrapPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Bins}" AutomationProperties.AutomationId="BinList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:BinRow}">
                                        <Border Background="{StaticResource Surface3}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}"/>
                                                    <Rectangle Width="22" Height="22" Fill="{Binding ColorHex}"
                                                               Stroke="{StaticResource LineStrong}" StrokeThickness="1"
                                                               HorizontalAlignment="Right" DockPanel.Dock="Right"/>
                                                </DockPanel>
                                                <WrapPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="Bin 类型（BR-43）" Style="{StaticResource FieldLabel}"/>
                                                        <ComboBox Style="{StaticResource FieldCombo}" SelectedItem="{Binding KindText, Mode=TwoWay}" IsEditable="False"
                                                                  ItemsSource="{Binding DataContext.FixedKinds, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="Bin 代码（BR-44）" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="类别名称" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="等级 0~3" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Level, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="颜色 #RRGGBB" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="快捷键（H08 复判）" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="备注 / Note" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="数量" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </WrapPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Button Content="保存本项" Style="{StaticResource PrimaryButton}" Width="96" Height="26"
                                                            Command="{Binding DataContext.SaveBinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.AutomationId="BtnSaveBin"/>
                                                    <Button Content="移除 Bin 代码" Style="{StaticResource GhostButton}" Width="110" Height="26" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.RemoveBinCodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.AutomationId="BtnRemoveBin"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 右：Map 图预览（F-3.7.2-11/12，唯一 MapGridView） -->
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="Map 图预览（H05 唯一渲染组件）" Style="{StaticResource PanelTitle}"/>
                            <TextBlock Text="{Binding RevisionText}" Style="{StaticResource MetaText}" HorizontalAlignment="Right"
                                       AutomationProperties.AutomationId="MapRevisionText"/>
                        </DockPanel>
                        <views:MapGridView Model="{Binding Map}" HorizontalAlignment="Left"
                                           AutomationProperties.AutomationId="MapPreview"/>
                        <TextBlock Text="{Binding GridStatusText}" Style="{StaticResource KeyText}" Margin="0,8,0,0"
                                   AutomationProperties.AutomationId="MapGridStatus"/>
                        <TextBlock Text="{Binding SelectedDieText}" Style="{StaticResource KeyText}" Margin="0,4,0,0"
                                   AutomationProperties.AutomationId="MapSelectedDie"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="生成 Map 图" Style="{StaticResource PrimaryButton}" Margin="0,0,6,6"
                                    Command="{Binding GenerateMapCommand}" AutomationProperties.AutomationId="BtnGenerateMap"/>
                            <Button Content="刷新图谱" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding RefreshMapCommand}" AutomationProperties.AutomationId="BtnRefreshMap"/>
                            <Button Content="模拟复判完成" Style="{StaticResource GhostButton}" Margin="0,0,6,6"
                                    Command="{Binding MarkDirtyCommand}" AutomationProperties.AutomationId="BtnMapMarkDirty"
                                    ToolTip="BR-53：数据变化后颜色不自动更新，须点刷新图谱"/>
                        </WrapPanel>
                        <WrapPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="X（列）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Width="70" Style="{StaticResource FieldBox}" Text="{Binding JumpX}"
                                         AutomationProperties.AutomationId="FieldMapJumpX"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Y（行）" Style="{StaticResource FieldLabel}"/>
                                <TextBox Width="70" Style="{StaticResource FieldBox}" Text="{Binding JumpY}"
                                         AutomationProperties.AutomationId="FieldMapJumpY"/>
                            </StackPanel>
                            <Button Content="X/Y 跳转" Style="{StaticResource GhostButton}" VerticalAlignment="Bottom" Height="28"
                                    Command="{Binding JumpToDieCommand}" AutomationProperties.AutomationId="BtnMapJump"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 页脚：快捷键验证、消费方同步与未迁移登记 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="快捷键验证（AC-H05-02）：" VerticalAlignment="Center" Style="{StaticResource KeyText}"/>
                        <TextBox Width="110" Style="{StaticResource FieldBox}" Text="{Binding ShortcutKey}"
                                 AutomationProperties.AutomationId="FieldShortcutKey"/>
                        <Button Content="验证" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding VerifyShortcutCommand}" AutomationProperties.AutomationId="BtnVerifyShortcut"/>
                        <TextBlock Text="{Binding ShortcutResult}" Style="{StaticResource KeyText}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" AutomationProperties.AutomationId="ShortcutResultText"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding ConsumerText}" Style="{StaticResource KeyText}" Margin="0,8,0,0"
                               AutomationProperties.AutomationId="MapConsumerText"/>
                    <TextBlock Text="{Binding DeferredNote}" Foreground="{StaticResource Warn}" FontSize="11.5"
                               TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
