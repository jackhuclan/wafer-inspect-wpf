<Window x:Class="WaferInspectHMI.Views.SubRecipeWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WaferInspectHMI.ViewModels.Modules"
        xmlns:views="clr-namespace:WaferInspectHMI.Views"
        Title="子配方向导" Width="1100" Height="800" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Surface}" FontFamily="Microsoft YaHei UI" FontSize="13"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Text3}"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <!-- 单个表单字段（标签 + 控件）的容器宽度，WrapPanel 自动排 4 列 -->
        <Style x:Key="FieldItem" TargetType="StackPanel">
            <Setter Property="Width" Value="236"/>
            <Setter Property="Margin" Value="0,0,16,14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 页头：Job 标题 + 子配方 CRUD（F-3.2.2-01~05） ============ -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding HeaderText}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource Text}"/>
                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="子配方：" VerticalAlignment="Center" Foreground="{StaticResource Text2}"/>
                    <ComboBox Width="260" Margin="0,0,8,0" Style="{StaticResource FieldCombo}"
                              ItemsSource="{Binding SubRecipes}" SelectedItem="{Binding SelectedSubRecipe, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              AutomationProperties.AutomationId="ComboSubRecipe"/>
                    <Button Content="新增" Style="{StaticResource GhostButton}" Width="56" Height="28" Margin="0,0,6,0"
                            Command="{Binding NewSubRecipeCommand}" AutomationProperties.AutomationId="BtnSubNew" ToolTip="F-3.2.2-01 十字新增"/>
                    <Button Content="复制" Style="{StaticResource GhostButton}" Width="56" Height="28" Margin="0,0,6,0"
                            Command="{Binding DuplicateSubRecipeCommand}" AutomationProperties.AutomationId="BtnSubDuplicate" ToolTip="F-3.2.2-04"/>
                    <Button Content="重命名" Style="{StaticResource GhostButton}" Width="66" Height="28" Margin="0,0,6,0"
                            Command="{Binding RenameSubRecipeCommand}" AutomationProperties.AutomationId="BtnSubRename" ToolTip="F-3.2.2-03"/>
                    <Button Content="删除" Style="{StaticResource GhostButton}" Width="56" Height="28" Margin="0,0,12,0"
                            Command="{Binding DeleteSubRecipeCommand}" AutomationProperties.AutomationId="BtnSubDelete" ToolTip="F-3.2.2-02"/>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="{StaticResource Text3}"
                               FontSize="11.5" TextTrimming="CharacterEllipsis"
                               AutomationProperties.AutomationId="WizardStatusText"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- ============ 主体：左步骤列表（T-042 顺序） + 右步骤内容 ============ -->
        <Grid Grid.Row="1" Margin="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：7 步列表（BR-19 可点击重入；B-25 拦截项禁用） -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="向导步骤（7 步 · T-042）" Style="{StaticResource PanelTitle}" Margin="2,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WizardStepRow}">
                                <Button Command="{Binding DataContext.EnterStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        IsEnabled="{Binding IsEnabled}"
                                        AutomationProperties.AutomationId="{Binding Key}"
                                        Margin="0,0,0,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{StaticResource Surface3}" CornerRadius="6"
                                                    Padding="10,8" BorderThickness="1"
                                                    BorderBrush="{StaticResource Line}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="12.5"
                                                                   Foreground="{StaticResource Text}"/>
                                                        <TextBlock Text="{Binding FailureNote}" FontSize="10.5"
                                                                   Foreground="#DC2626" TextWrapping="Wrap"
                                                                   Visibility="{Binding FailureNote, Converter={StaticResource NonEmptyVis}}"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="Status" Grid.Column="1" Text="{Binding StatusText}"
                                                               FontSize="10.5" Foreground="{StaticResource Text3}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="True">
                                                    <Setter TargetName="Bd" Property="Cursor" Value="Hand"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="点击步骤进入/重入（BR-19）；完成前一步才允许下一步（B-25）。"
                               FontSize="10.5" Foreground="{StaticResource Text3}" TextWrapping="Wrap" Margin="2,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 右：步骤内容（7 个面板 Visibility 切换，不用 ContentControl+Template） -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding StepNote}" FontSize="11.5" Foreground="{StaticResource Text3}"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                      <Grid>
                        <!-- ======== 步骤 1：基础信息（T-005 全字段） ======== -->
                        <StackPanel Visibility="{Binding IsBasicInfo, Converter={StaticResource BoolVis}}">
                            <Border Style="{StaticResource Card}" Background="{StaticResource Surface3}" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="晶圆信息" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="名称 *" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiName, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.AutomationId="FieldBiName"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="晶圆类型" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding PatternTypeOptions}"
                                                      Text="{Binding BiPatternType}" IsEditable="False"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="晶圆尺寸" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding SizeOptions}"
                                                      Text="{Binding BiSize}" IsEditable="False"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="晶圆材料（固定 Si）" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiMaterial}" IsReadOnly="True"
                                                     Background="#F1F5F9"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="晶圆厚度" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiThickness, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="Die X (mm)" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiDieX, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="Die Y (mm) *" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiDieY, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.AutomationId="FieldBiDieY"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="Notch 方向（°，默认 270）" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiNotch, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="图谱选择 *" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding MapTypeNames}"
                                                      Text="{Binding BiMapType}" IsEditable="False"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="Map 文件类型 *" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding MapFileTypeOptions}"
                                                      Text="{Binding BiMapFileType}" IsEditable="False"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="Bin 等级设定" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiBinGrade, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="列方向" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding DirectionOptions}"
                                                      Text="{Binding BiColumnDirection}" IsEditable="False"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="行方向" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding DirectionOptions}"
                                                      Text="{Binding BiRowDirection}" IsEditable="False"/>
                                        </StackPanel>
                                        <StackPanel Width="488" Style="{StaticResource FieldItem}">
                                            <TextBlock Text="Map 文件 *" Style="{StaticResource FieldLabel}"/>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="导入" Style="{StaticResource GhostButton}"
                                                        Width="66" Height="30" Margin="6,0,0,0"
                                                        Command="{Binding BrowseMapFileCommand}" AutomationProperties.AutomationId="BtnBiBrowseMap"/>
                                                <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiMapPath, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.AutomationId="FieldBiMapPath"/>
                                            </DockPanel>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="图谱 Notch 方向（°）*" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiMapNotch, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.AutomationId="FieldBiMapNotch"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Background="{StaticResource Surface3}" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="解析脚本" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <StackPanel Width="488" Style="{StaticResource FieldItem}">
                                            <TextBlock Text="解析脚本" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiParseScript, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="条码 *" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiBarcode, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.AutomationId="FieldBiBarcode"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="OCR Job" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiOcrJob, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="OCR 识别角度（°）" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiOcrAngle, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="OCR 位置" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding OcrPositionOptions}"
                                                      Text="{Binding BiOcrPosition}" IsEditable="False"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="定位 Die X" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiLocateDieX, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="定位 Die Y" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiLocateDieY, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="方向" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiOrientation, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="列偏移" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiColumnOffset, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="行偏移" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiRowOffset, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="Col" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiColRow, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="Row / X / Y" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiXy, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="Include/Exclude" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiIncludeExclude, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="使用 Klar 圆心巡边工具" Style="{StaticResource FieldLabel}"/>
                                            <CheckBox IsChecked="{Binding BiUseKlarCenterTool}" VerticalAlignment="Center" Height="30"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Background="{StaticResource Surface3}" Padding="10" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="回溯图存储 / Mapping / 抽检区" Style="{StaticResource PanelTitle}" Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="回溯图存储（BR-15）" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding TraceImageOptions}"
                                                      Text="{Binding BiTraceImage}" IsEditable="False"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="Mapping 厚度" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiMappingThickness, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="Mapping SlotNum" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Style="{StaticResource FieldBox}" Text="{Binding BiMappingSlotNum, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Style="{StaticResource FieldItem}">
                                            <TextBlock Text="抽检区设置（区域明细见 ROI 步骤）" Style="{StaticResource FieldLabel}"/>
                                            <CheckBox IsChecked="{Binding BiSamplingZoneEnabled}" VerticalAlignment="Center" Height="30"/>
                                        </StackPanel>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ======== 步骤 2：拉平（BR-22/23/24，H03 引擎真实执行） ======== -->
                        <StackPanel Visibility="{Binding IsLeveling, Converter={StaticResource BoolVis}}">
                            <WrapPanel Margin="0,6,0,0">
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="拉平模式（BR-22）" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding LevelingModeOptions}"
                                              Text="{Binding LvMode}" IsEditable="False" AutomationProperties.AutomationId="FieldLvMode"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="模板类型（BR-23）" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding TemplateTypeOptions}"
                                              Text="{Binding LvTemplateType}" IsEditable="False" AutomationProperties.AutomationId="FieldLvTemplate"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="匹配分数（BR-24，0~100）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding LvScore, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldLvScore"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- 视窗图像框选（F-3.2.2-38：拖拽框选区域，松开自动执行拉平） -->
                            <TextBlock Text="视窗图像（模拟来源，H06 采集随 T-029 搁置；匹配计算真实执行）：拖拽框选含特征的 Die 区域"
                                       Style="{StaticResource FieldLabel}" Margin="0,10,0,4"/>
                            <Canvas x:Name="FovCanvas" Width="480" Height="360" Background="#1B2536" HorizontalAlignment="Left"
                                    Cursor="Cross" MouseLeftButtonDown="FovCanvas_MouseLeftButtonDown"
                                    MouseMove="FovCanvas_MouseMove" MouseLeftButtonUp="FovCanvas_MouseLeftButtonUp"
                                    AutomationProperties.AutomationId="FovCanvas">
                                <Image Source="{Binding FovPreview}" Width="480" Height="360" IsHitTestVisible="False"/>
                                <Rectangle x:Name="FovSelRect" Stroke="#2563EB" StrokeThickness="2"
                                           Fill="#22563EB2" Visibility="Collapsed"/>
                            </Canvas>

                            <WrapPanel Margin="0,8,0,0">
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="区域 X" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Width="64" Text="{Binding LvRegionX, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldLvRegionX"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="区域 Y" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Width="64" Text="{Binding LvRegionY, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldLvRegionY"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="宽" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Width="64" Text="{Binding LvRegionW, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldLvRegionW"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="高" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Width="64" Text="{Binding LvRegionH, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldLvRegionH"/>
                                </StackPanel>
                                <Button Content="执行拉平" Style="{StaticResource PrimaryButton}" Width="96" Height="30" Margin="6,18,0,0"
                                        Command="{Binding ExecuteLevelingFromFieldsCommand}" AutomationProperties.AutomationId="BtnExecuteLeveling"/>
                            </WrapPanel>

                            <TextBlock Text="{Binding LvResultText}" Style="{StaticResource KeyText}" Margin="0,8,0,2"
                                       AutomationProperties.AutomationId="LvResultText"/>
                            <TextBlock Text="{Binding LvScoreText}" Style="{StaticResource KeyText}" Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="LvScoreText"/>
                            <TextBlock Text="{Binding LvLightText}" Style="{StaticResource KeyText}" Foreground="{StaticResource Text3}" Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="LvLightText"/>
                            <TextBlock Text="{Binding LvAdvisories}" Style="{StaticResource KeyText}" Foreground="#B45309" Margin="0,2,0,0"
                                       TextWrapping="Wrap" AutomationProperties.AutomationId="LvAdvisories"/>
                        </StackPanel>

                        <!-- ======== 步骤 3：Mark（BR-25/26，H03 图形化交互） ======== -->
                        <StackPanel Visibility="{Binding IsMark, Converter={StaticResource BoolVis}}">
                            <WrapPanel Margin="0,6,0,0">
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="拉平方向（F-3.2.2-49）" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding MarkMethodOptions}"
                                              Text="{Binding MkMethod}" IsEditable="False" AutomationProperties.AutomationId="FieldMkMethod"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="当前编辑 Mark" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding MarkIndexOptions}"
                                              SelectedIndex="{Binding SelectedMarkIndex}" IsEditable="False" AutomationProperties.AutomationId="FieldMarkIndex"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="缩略图比例（BR-27，1/2ⁿ）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Width="72" Text="{Binding MkThumbRatio, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldMkThumbRatio"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="缩略图倍镜（BR-28，维持默认）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Width="72" Text="{Binding MkMagnifier, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldMkMagnifier"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="扫描轴速度（F-3.2.2-43）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Width="72" Text="{Binding MkSpeed, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldMkSpeed"/>
                                </StackPanel>
                            </WrapPanel>

                            <!-- Map 定位网格（F-3.2.2-45~47：拖动对位 → 确定锁定 → 双击 Die 填行列） -->
                            <TextBlock Text="{Binding MkGridStatusText}" Style="{StaticResource KeyText}" Margin="0,8,0,4"
                                       AutomationProperties.AutomationId="MkGridStatusText"/>
                            <Canvas x:Name="MarkGridCanvas" Width="460" Height="240" Background="#EDF2F8" HorizontalAlignment="Left"
                                    Cursor="Hand" ClipToBounds="True"
                                    PreviewMouseLeftButtonDown="MarkGrid_PreviewMouseLeftButtonDown"
                                    MouseMove="MarkGrid_MouseMove" MouseLeftButtonUp="MarkGrid_MouseLeftButtonUp"
                                    AutomationProperties.AutomationId="MarkGridCanvas">
                                <ItemsControl ItemsSource="{Binding MarkGridCells}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                            <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="16" Height="16" Background="{Binding Fill}" BorderBrush="#94A8C2" BorderThickness="0.5"
                                                    CornerRadius="1.5" ToolTip="{Binding Tip}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Canvas>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="确定 Map 定位" Style="{StaticResource PrimaryButton}" Width="104" Height="28" Margin="0,0,6,4"
                                        Command="{Binding ConfirmMapLocationCommand}" AutomationProperties.AutomationId="BtnConfirmMapLocation"
                                        ToolTip="F-3.2.2-46：锁定网格，不可再移动"/>
                                <Button Content="重置 Map 定位" Style="{StaticResource GhostButton}" Width="104" Height="28" Margin="0,0,6,4"
                                        Command="{Binding ResetMapLocationCommand}" AutomationProperties.AutomationId="BtnResetMapLocation"
                                        ToolTip="F-3.2.2-47：删除 Map 图"/>
                                <Button Content="指定 Die 左上角" Style="{StaticResource GhostButton}" Width="110" Height="28" Margin="0,0,6,4"
                                        Command="{Binding SpecifyDieTopLeftCommand}" AutomationProperties.AutomationId="BtnSpecifyDieTopLeft"
                                        ToolTip="F-3.2.2-50：平台 X/Y 写入当前 Mark（必做）"/>
                                <Button Content="移动到中心" Style="{StaticResource GhostButton}" Width="88" Height="28" Margin="0,0,6,4"
                                        Command="{Binding MoveToCenterCommand}" AutomationProperties.AutomationId="BtnMoveToCenter"
                                        ToolTip="F-3.2.2-54（设备动作，T-029 搁置）"/>
                                <Button Content="移动到模板" Style="{StaticResource GhostButton}" Width="88" Height="28" Margin="0,0,6,4"
                                        Command="{Binding MoveToTemplateCommand}" AutomationProperties.AutomationId="BtnMoveToTemplate"
                                        ToolTip="F-3.2.2-55（设备动作，T-029 搁置）"/>
                                <Button Content="点位重置（慎用）" Style="{StaticResource GhostButton}" Width="110" Height="28"
                                        Command="{Binding ResetMarkPointsCommand}" AutomationProperties.AutomationId="BtnResetMarkPoints"
                                        ToolTip="F-3.2.2-56：清空 Mark 列表，需二次确认（T-024）"/>
                            </WrapPanel>

                            <ItemsControl ItemsSource="{Binding MarkRows}" AutomationProperties.AutomationId="MarkList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:MarkRow}">
                                        <Border Background="{StaticResource Surface3}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource PanelTitle}" Margin="0,0,0,6"/>
                                                <WrapPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="行" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Row, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="列" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Col, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="平台 X" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding PlatformX, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="平台 Y" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding PlatformY, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ======== 步骤 4：参考图像（F-3.2.2-60~67，H03 规划器） ======== -->
                        <StackPanel Visibility="{Binding IsReferenceImage, Converter={StaticResource BoolVis}}">
                            <WrapPanel Margin="0,6,0,0">
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="参考 Die 数量（F-3.2.2-67）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Width="80" Text="{Binding RiCount, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldRiCount"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="视野缩放（F-3.2.2-62，BR-30）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Width="80" Text="{Binding RiFovZoom, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldRiFovZoom"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="Block（F-3.2.2-61，推荐忽略）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Width="110" Text="{Binding RiBlock, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldRiBlock"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="Golden 创建参数（F-3.2.2-65，推荐忽略）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource FieldBox}" Width="140" Text="{Binding RiGoldenParam, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldRiGoldenParam"/>
                                </StackPanel>
                            </WrapPanel>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="创建参考图像" Style="{StaticResource PrimaryButton}" Width="110" Height="30" Margin="0,0,6,4"
                                        Command="{Binding CreateReferenceImageCommand}" AutomationProperties.AutomationId="BtnCreateRefImage"
                                        ToolTip="F-3.2.2-67：随机标出参考 Die 并生成 Golden Die；成功后才允许下一步"/>
                                <Button Content="FOV 图谱手动调整" Style="{StaticResource GhostButton}" Width="124" Height="30" Margin="0,0,6,4"
                                        Command="{Binding RiManualAdjustCommand}" AutomationProperties.AutomationId="BtnRiManualAdjust"
                                        ToolTip="F-3.2.2-64/66：Golden 生成失败或效果欠佳时的手动调整入口"/>
                            </WrapPanel>

                            <TextBlock Text="{Binding RiSummaryText}" Style="{StaticResource KeyText}" Margin="0,8,0,4" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="RiSummaryText"/>

                            <StackPanel Width="560" Margin="0,6,0,0">
                                <TextBlock Text="参考图像文件（可选：图像采集属 H06，T-029 搁置，当前支持选择本地文件）" Style="{StaticResource FieldLabel}"/>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="选择图像…" Style="{StaticResource GhostButton}"
                                            Width="96" Height="30" Margin="6,0,0,0"
                                            Command="{Binding BrowseReferenceImageCommand}" AutomationProperties.AutomationId="BtnRiBrowse"/>
                                    <TextBox Style="{StaticResource FieldBox}" Text="{Binding RiImagePath, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="FieldRiPath"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- ======== 步骤 5：ROI（H04 唯一数据源，AC-P2-03 / F-3.2.2-68~75） ======== -->
                        <StackPanel Visibility="{Binding IsRoi, Converter={StaticResource BoolVis}}">
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="{x:Static vm:SubRecipeWizardViewModel.RoiWorkflowText}"
                                               Style="{StaticResource KeyText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding RoiSourceText}" Style="{StaticResource MetaText}" Margin="0,4,0,0"
                                               TextWrapping="Wrap" AutomationProperties.AutomationId="RoiSourceText"/>
                                </StackPanel>
                            </Border>

                            <!-- 共享 Map 画布：拖拽圈选 ROI 区域（F-3.2.2-70） -->
                            <TextBlock Text="Map 画布（拖拽圈选 ROI 区域；1-based Die 网格）" Style="{StaticResource FieldLabel}"/>
                            <views:MapRegionCanvas HorizontalAlignment="Left" Margin="0,0,0,10" State="{Binding Map}"
                                                   AutomationProperties.AutomationId="WizardRoiMapCanvas"/>

                            <TextBlock Text="ROI 区域表（编辑后点击「应用区域编辑」，或完成本步时自动应用）"
                                       Style="{StaticResource FieldLabel}"/>
                            <ItemsControl ItemsSource="{Binding RoiRows}" AutomationProperties.AutomationId="RoiList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoiZoneRow}">
                                        <Border Background="{StaticResource Surface3}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource PanelTitle}"/>
                                                    <Button DockPanel.Dock="Right" Content="移除" Style="{StaticResource GhostButton}"
                                                            Width="56" Height="24" HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.RemoveRoiZoneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </DockPanel>
                                                <WrapPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="起始列 X" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="FieldRoiX"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="起始行 Y" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="FieldRoiY"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="列数" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="FieldRoiW"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="行数" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="FieldRoiH"/>
                                                    </StackPanel>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <WrapPanel Margin="0,2,0,10">
                                <Button Content="添加 ROI 区域" Style="{StaticResource GhostButton}" Width="110" Height="28" Margin="0,0,8,0"
                                        Command="{Binding AddRoiZoneCommand}" AutomationProperties.AutomationId="BtnAddRoi"/>
                                <Button Content="应用区域编辑" Style="{StaticResource GhostButton}" Width="110" Height="28"
                                        Command="{Binding ApplyRoiRowsCommand}" AutomationProperties.AutomationId="BtnApplyRoiRows"/>
                            </WrapPanel>

                            <!-- 检测设置列表（F-3.2.2-69：每项为独立检测单元，保存后才算完成） -->
                            <TextBlock Text="检测设置列表（每项：名称 / 算法类型 / Golden 模板区域 / 参数类型 / 区域提取 / 明·暗 Golden）"
                                       Style="{StaticResource FieldLabel}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding RoiItemStatusText}" Style="{StaticResource MetaText}"
                                       AutomationProperties.AutomationId="RoiItemStatusText"/>
                            <ItemsControl ItemsSource="{Binding RoiItemRows}" Margin="0,6,0,0"
                                          AutomationProperties.AutomationId="RoiItemList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RoiItemRow}">
                                        <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding SavedText}" Style="{StaticResource MetaText}" DockPanel.Dock="Right"/>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource PanelTitle}"/>
                                                </DockPanel>
                                                <WrapPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="① 名称" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="区域划分（F-3.2.2-68）" Style="{StaticResource FieldLabel}"/>
                                                        <ComboBox Style="{StaticResource FieldCombo}" Text="{Binding Kind}" IsEditable="False"
                                                                  ItemsSource="{Binding DataContext.TargetKindOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="② 算法类型" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding AlgorithmType, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="③ 模板区域 起始列/行" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding RegionX, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="模板区域 起始行" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding RegionY, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="模板区域 列数" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding RegionW, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="模板区域 行数" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding RegionH, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="⑤ 参数类型（BR-35）" Style="{StaticResource FieldLabel}"/>
                                                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding ParameterType, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="区域提取算法（F-3.2.2-71）" Style="{StaticResource FieldLabel}"/>
                                                        <ComboBox Style="{StaticResource FieldCombo}" Text="{Binding Extraction}" IsEditable="False"
                                                                  ItemsSource="{Binding DataContext.ExtractionOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </StackPanel>
                                                    <StackPanel Style="{StaticResource FieldItem}">
                                                        <TextBlock Text="Golden 明/暗（F-3.2.2-73）" Style="{StaticResource FieldLabel}"/>
                                                        <ComboBox Style="{StaticResource FieldCombo}" Text="{Binding GoldenTone}" IsEditable="False"
                                                                  ItemsSource="{Binding DataContext.GoldenToneOptions, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </StackPanel>
                                                </WrapPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button Content="⑥ 保存本项" Style="{StaticResource PrimaryButton}" Width="100" Height="26"
                                                            Command="{Binding DataContext.SaveDetectionItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            AutomationProperties.AutomationId="BtnSaveRoiItem"/>
                                                    <Button Content="移除" Style="{StaticResource GhostButton}" Width="70" Height="26" Margin="8,0,0,0"
                                                            Command="{Binding DataContext.RemoveDetectionItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource MetaText}" Margin="10,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="② 新增检测项" Style="{StaticResource GhostButton}" Width="120" Height="28" Margin="0,2,0,0"
                                    Command="{Binding AddDetectionItemCommand}" AutomationProperties.AutomationId="BtnAddRoiItem"/>
                        </StackPanel>

                        <!-- ======== 步骤 6：扫描区域（H04 唯一数据源，BR-37~39） ======== -->
                        <StackPanel Visibility="{Binding IsScanArea, Converter={StaticResource BoolVis}}" Margin="0,6,0,0">
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="10,7" Margin="0,0,0,10">
                                <TextBlock Text="{Binding RoiSourceText}" Style="{StaticResource KeyText}" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="ScanSourceText"/>
                            </Border>
                            <WrapPanel Margin="0,0,0,10">
                                <CheckBox IsChecked="{Binding ScanFullWafer}" Content="全片扫描（BR-37 默认：检测整个 Map 图区域）"
                                          FontSize="12.5" Margin="0,0,16,0" AutomationProperties.AutomationId="ChkScanFullWafer"/>
                                <CheckBox IsChecked="{Binding SamplingEnabled}" Content="抽检（双击 Map Die，BR-38 可多个）"
                                          FontSize="12.5" AutomationProperties.AutomationId="ChkScanSampling"/>
                            </WrapPanel>
                            <TextBlock Text="Map 画布（拖拽添加扫描区域，可单个或多个；双击 Die = 抽检）" Style="{StaticResource FieldLabel}"/>
                            <views:MapRegionCanvas HorizontalAlignment="Left" Margin="0,0,0,10" State="{Binding Map}"
                                                   AutomationProperties.AutomationId="WizardScanMapCanvas"/>
                            <WrapPanel>
                                <Button Content="引用 ROI 区域" Style="{StaticResource GhostButton}" Width="120" Height="28" Margin="0,0,8,0"
                                        Command="{Binding AddScanRegionsFromRoiCommand}" AutomationProperties.AutomationId="BtnAddScanFromRoi"/>
                                <Button Content="清除扫描区域" Style="{StaticResource GhostButton}" Width="110" Height="28" Margin="0,0,8,0"
                                        Command="{Binding ClearScanRegionsCommand}" AutomationProperties.AutomationId="BtnClearScanRegions"/>
                                <Button Content="清空抽检 Die" Style="{StaticResource GhostButton}" Width="110" Height="28"
                                        Command="{Binding ClearSamplingDiesCommand}" AutomationProperties.AutomationId="BtnClearSamplingDies"/>
                            </WrapPanel>
                            <TextBlock Text="已定义扫描区域（与缺陷分析 · 参数验证页同一份数据，AC-P2-03）"
                                       Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                            <ItemsControl ItemsSource="{Binding Map.Regions}" MaxHeight="110"
                                          AutomationProperties.AutomationId="WizardScanRegionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Tip}" Style="{StaticResource KeyText}" Margin="0,0,0,3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ======== 步骤 7：复判设置（F-3.2.2-80~82，BR-20） ======== -->
                        <StackPanel Visibility="{Binding IsRecheck, Converter={StaticResource BoolVis}}">
                            <WrapPanel Margin="0,6,0,0">
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="复判模式（BR-20）" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Style="{StaticResource FieldCombo}" ItemsSource="{Binding RecheckModeOptions}"
                                              Text="{Binding RcMode}" IsEditable="False" AutomationProperties.AutomationId="FieldRcMode"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource FieldItem}">
                                    <TextBlock Text="相机类型（BR-20）" Style="{StaticResource FieldLabel}"/>
                                    <CheckBox IsChecked="{Binding RcUseReviewCamera}" Content="复查相机"
                                              VerticalAlignment="Center" Height="30"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                      </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 页脚：校验面板 + 导航按钮 ============ -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding ValidationSummary}" Foreground="#DC2626" FontSize="11.5"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding HasValidationError, Converter={StaticResource BoolVis}}"
                           AutomationProperties.AutomationId="WizardValidation"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="上一步" Style="{StaticResource GhostButton}" Width="88" Height="30" Margin="0,0,8,0"
                            Command="{Binding PreviousStepCommand}" AutomationProperties.AutomationId="BtnPrevStep"/>
                    <Button Content="保存并完成本步" Style="{StaticResource PrimaryButton}" Width="128" Height="30" Margin="0,0,8,0"
                            Command="{Binding CompleteStepCommand}" AutomationProperties.AutomationId="BtnCompleteStep"/>
                    <Button Content="下一步" Style="{StaticResource GhostButton}" Width="88" Height="30" Margin="0,0,8,0"
                            Command="{Binding NextStepCommand}" AutomationProperties.AutomationId="BtnNextStep"/>
                    <Button Content="关闭" Style="{StaticResource GhostButton}" Width="88" Height="30"
                            Click="Close_Click" AutomationProperties.AutomationId="BtnWizardClose"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
