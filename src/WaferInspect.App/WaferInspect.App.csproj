<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>WaferInspectHMI</AssemblyName>
    <RootNamespace>WaferInspectHMI</RootNamespace>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WaferInspect.Core/WaferInspect.Core.csproj" />
  </ItemGroup>

  <ItemGroup Label="MVVM 与通用主机">
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <!-- H02 Job 种子数据引用的样例 Map 文件：随产物输出到 samples/，供「Map 文件」导入演示与回归使用 -->
  <ItemGroup Label="样例 Map 文件">
    <Content Include="..\..\assets\map-samples\*.csv;..\..\assets\map-samples\*.txt"
             Link="samples\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
