<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- 纯数据契约层先启用可空引用；App 层仍按 Directory.Build.props 的渐进策略 disable -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 仅使用 DI 抽象（IServiceCollection）注册 Core 服务，不引用任何 UI / Windows 类型 -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

</Project>
